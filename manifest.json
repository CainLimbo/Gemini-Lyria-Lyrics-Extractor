{
  "manifest_version": 3,
  "name": "Gemini Lyria Lyric Extractor",
  "version": "1.1.0",
  "description": "Adds a floating Copy and Download (.txt) lyric extractor on gemini.google.com.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}